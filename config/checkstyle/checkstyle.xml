<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  RECODE regression guard (Phase 7). Enforces the house rule against dead and
  redundant declarations: unused/duplicate/star imports and unused local
  variables. Inline fully-qualified names that remain are genuine simple-name
  clashes (kept with a comment per the house rule) and are not import lines, so
  they are not flagged here.
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="RedundantImport"/>
        <module name="UnusedLocalVariable"/>
    </module>
</module>
